TYPESAFE_API_KEY=
OPENAI_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_MODEL=gpt-4.1-mini
# Use your OpenAI-compatible provider's API base URL (usually ending in /v1).
# OPENAI_BASE_URL=https://your-provider.example/v1
# Or provide the complete endpoint; this takes precedence over OPENAI_BASE_URL.
# OPENAI_URL=https://your-provider.example/v1/chat/completions
# EMAIL_DB_FILE=data/emails.db
# EMAIL_IMAP_ENABLED=true
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_USERNAME=support@example.com
# EMAIL_IMAP_PASSWORD=your-app-password
